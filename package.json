{
  "name": "rsmine-desktop",
  "productName": "RSMine",
  "version": "1.3.1",
  "description": "RSMine — локальная программа стримера: LZT-платежи и алерты",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "ru.rsmine.desktop",
    "productName": "RSMine",
    "files": [
      "main.js",
      "ui/**",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "ws": "^8.18.0"
  }
}